{
  "name": "dsh-prime-diary",
  "version": "0.10.16",
  "description": "为 dsh-prime-memory 增加每日日记、重要记忆筛选与草稿审阅的伴生插件",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "optionalDependencies": {
    "@node-rs/jieba": "^2.0.4"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}